<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Repair Order Report Template -->
    <template id="report_repair_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <!-- Header -->
                        <h2>
                            <span t-if="o.state == 'draft'">Quotation for Repair: </span>
                            <span t-else="">Repair Order: </span>
                            <span t-field="o.name"/>
                        </h2>

                        <!-- Customer and Product Info -->
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <div t-field="o.partner_id" 
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                            </div>
                            <div class="col-6">
                                <strong>Product:</strong>
                                <div><span t-field="o.product_id"/></div>
                                <t t-if="o.lot_id">
                                    <strong>Serial Number:</strong>
                                    <div><span t-field="o.lot_id"/></div>
                                </t>
                                <t t-if="o.lot_id and o.lot_id.grz_number">
                                    <strong>GRZ Number:</strong>
                                    <div><span t-field="o.lot_id.grz_number"/></div>
                                </t>
                            </div>
                        </div>

                        <!-- Repair Details -->
                        <div class="row mb8">
                            <div class="col-6">
                                <strong>Repair Date:</strong> <span t-field="o.create_date" t-options='{"widget": "date"}'/>
                            </div>
                            <div class="col-6" t-if="o.user_id">
                                <strong>Responsible:</strong> <span t-field="o.user_id"/>
                            </div>
                        </div>

                        <t t-if="o.description">
                            <div class="row mb16">
                                <div class="col-12">
                                    <strong>Problem Description:</strong>
                                    <p t-field="o.description"/>
                                </div>
                            </div>
                        </t>

                        <!-- Parts Used -->
                        <t t-if="o.move_ids">
                            <h4 class="mt16">Parts</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.move_ids" t-as="move">
                                        <td><span t-field="move.product_id"/></td>
                                        <td class="text-end"><span t-field="move.product_uom_qty"/></td>
                                        <td class="text-end">
                                            <span t-field="move.product_id.standard_price" 
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="move.product_uom_qty * move.product_id.standard_price" 
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- Operations/Services -->
                        <t t-if="o.fees_lines">
                            <h4 class="mt16">Operations/Services</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th t-if="any(fee.product_id for fee in o.fees_lines)">Service</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.fees_lines" t-as="fee">
                                        <td><span t-field="fee.name"/></td>
                                        <td t-if="any(f.product_id for f in o.fees_lines)">
                                            <span t-field="fee.product_id"/>
                                        </td>
                                        <td class="text-end"><span t-field="fee.product_uom_qty"/></td>
                                        <td class="text-end">
                                            <span t-field="fee.price_unit" 
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="fee.price_subtotal" 
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- Totals -->
                        <div class="row justify-content-end">
                            <div class="col-4">
                                <table class="table table-sm">
                                    <tr t-if="o.parts_amount > 0">
                                        <td><strong>Parts Total:</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.parts_amount" 
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.fees_amount > 0">
                                        <td><strong>Services Total:</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.fees_amount" 
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="border-top">
                                        <td><strong>Total:</strong></td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-field="o.total_amount" 
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Internal Notes -->
                        <t t-if="o.internal_notes">
                            <div class="row mt16">
                                <div class="col-12">
                                    <strong>Internal Notes:</strong>
                                    <p t-field="o.internal_notes"/>
                                </div>
                            </div>
                        </t>

                        <!-- Quotation Notes -->
                        <t t-if="o.quotation_notes">
                            <div class="row mt16">
                                <div class="col-12">
                                    <strong>Quotation Notes:</strong>
                                    <p t-field="o.quotation_notes"/>
                                </div>
                            </div>
                        </t>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Payment Receipt Template -->
    <template id="report_repair_receipt_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <!-- Receipt Header -->
                        <div class="text-center">
                            <h2>PAYMENT RECEIPT</h2>
                            <h4>Receipt No: <span t-field="o.name"/></h4>
                        </div>

                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Received From:</strong>
                                <div t-field="o.partner_id" 
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                            </div>
                            <div class="col-6">
                                <t t-if="o.payment_date">
                                    <strong>Date:</strong> <span t-field="o.payment_date" t-options='{"widget": "date"}'/><br/>
                                </t>
                                <t t-else="">
                                    <strong>Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/><br/>
                                </t>
                                <t t-if="o.payment_method">
                                    <strong>Payment Method:</strong> <span t-field="o.payment_method"/><br/>
                                </t>
                                <t t-if="o.payment_reference">
                                    <strong>Reference:</strong> <span t-field="o.payment_reference"/><br/>
                                </t>
                            </div>
                        </div>

                        <!-- Service Details -->
                        <div class="row mb16">
                            <div class="col-12">
                                <strong>For:</strong> Repair Services
                            </div>
                        </div>

                        <div class="row mb16">
                            <div class="col-6">
                                <strong>Repair Order:</strong> <span t-field="o.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Product:</strong> <span t-field="o.product_id"/>
                            </div>
                        </div>

                        <t t-if="o.lot_id">
                            <div class="row mb16">
                                <div class="col-6">
                                    <strong>Serial Number:</strong> <span t-field="o.lot_id"/>
                                </div>
                                <div class="col-6" t-if="o.lot_id.grz_number">
                                    <strong>GRZ Number:</strong> <span t-field="o.lot_id.grz_number"/>
                                </div>
                            </div>
                        </t>

                        <!-- Payment Summary -->
                        <div class="row mt32 mb32">
                            <div class="col-12">
                                <table class="table table-bordered">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Description</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="o.parts_amount > 0">
                                            <td>Parts</td>
                                            <td class="text-end">
                                                <span t-field="o.parts_amount" 
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr t-if="o.fees_amount > 0">
                                            <td>Services/Operations</td>
                                            <td class="text-end">
                                                <span t-field="o.fees_amount" 
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr class="table-active">
                                            <td><strong>Total Amount</strong></td>
                                            <td class="text-end">
                                                <strong>
                                                    <span t-field="o.total_amount" 
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                        <tr t-if="o.paid_amount > 0">
                                            <td><strong>Amount Paid</strong></td>
                                            <td class="text-end">
                                                <strong>
                                                    <span t-field="o.paid_amount" 
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                        <t t-if="o.balance_amount != 0">
                                            <tr class="table-warning">
                                                <td><strong>Balance Due</strong></td>
                                                <td class="text-end">
                                                    <strong>
                                                        <span t-field="o.balance_amount" 
                                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </strong>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Amount in Words -->
                        <div class="row mb32">
                            <div class="col-12">
                                <strong>Amount in words:</strong>
                                <p><em><span t-esc="o.currency_id.amount_to_text(o.paid_amount if o.paid_amount > 0 else o.total_amount)"/></em></p>
                            </div>
                        </div>

                        <!-- Signature Section -->
                        <div class="row mt64">
                            <div class="col-6">
                                <div class="text-center">
                                    <p>_______________________</p>
                                    <p><strong>Customer Signature</strong></p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center">
                                    <p>_______________________</p>
                                    <p><strong>Received By</strong></p>
                                    <t t-if="o.received_by">
                                        <p><span t-field="o.received_by"/></p>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt32">
                            <p class="text-muted">Thank you for your business!</p>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
