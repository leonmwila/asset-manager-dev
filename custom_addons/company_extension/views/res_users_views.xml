<odoo>
    <record id="view_users_tree_inherit_institution" model="ir.ui.view">
        <field name="name">res.users.tree.inherit.institution</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="company_id" string="Institution"/>
            </xpath>
        </field>
    </record>
</odoo>
