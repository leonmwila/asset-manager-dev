<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Stock Production Lot Form View to add GRZ Number -->
    <record id="view_stock_production_lot_form_inherit_grz_number" model="ir.ui.view">
        <field name="name">stock.production.lot.form.inherit.grz.number</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <group>
                    <field name="program_id" string="Program"/>
                    <field name="project_id" string="Project"/>
                    <field name="assigned_to" string="Assigned To"/>
                    <field name="product_model" string="Model" readonly="1"/>
                    <field name="grz_number_b" string="GRZ Number B" options="{'no_create': True, 'no_edit': True}"/>
                    <field name="grz_number" string="GRZ Number" readonly="1"/>
                </group>
                <field name="is_vehicle" invisible="1"/>
                <group string="Vehicle Information" invisible="not is_vehicle">
                    <field name="vehicle_make" string="Make"/>
                    <field name="engine_no" string="Engine No"/>
                    <field name="plate_no" string="Plate No"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Override list view to change column headers -->
    <record id="view_stock_production_lot_tree_inherit_grz_number" model="ir.ui.view">
        <field name="name">stock.production.lot.tree.inherit.grz.number</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Replace field labels with explicit string attributes -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Serial Number</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="string">Description</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="string">Institution</attribute>
            </xpath>
            <!-- Add Model, GRZ Number, Province, and Station columns after Company -->
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="product_model" string="Model" optional="show"/>
                <field name="grz_number" string="GRZ Number" optional="show"/>
                <field name="province_id" string="Province" optional="hide"/>
                <field name="district_id" string="Station" optional="show"/>
                <field name="standard_price" string="Acquisition Price" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add Category filter to search view -->
    <record id="search_product_lot_filter_inherit_category" model="ir.ui.view">
        <field name="name">stock.production.lot.search.inherit.category</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <!-- Add Category, Category 2, and Station fields for searching -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="categ_id" string="Category"/>
                <field name="category_2_id" string="Description Category 2"/>
                <field name="district_id" string="Station"/>
            </xpath>
            <!-- Add Category, Category 2, and Station to Group By filters -->
            <xpath expr="//filter[@name='group_by_product']" position="after">
                <filter name="group_by_category" string="Category" domain="[]" context="{'group_by': 'categ_id'}"/>
                <filter name="group_by_category_2" string="Description Category 2" domain="[]" context="{'group_by': 'category_2_id'}"/>
                <filter name="group_by_station" string="Station" domain="[]" context="{'group_by': 'district_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
