<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_repair_transfer_request_wizard" model="ir.ui.view">
        <field name="name">repair.transfer.request.wizard.form</field>
        <field name="model">repair.transfer.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Request">
                <group>
                    <field name="repair_id" readonly="1"/>
                    <field name="dest_company_id" required="1"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_repair_return_request_wizard" model="ir.ui.view">
        <field name="name">repair.return.request.wizard.form</field>
        <field name="model">repair.return.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Request">
                <group>
                    <field name="repair_id" readonly="1"/>
                    <field name="dest_company_id" required="1"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_repair_end_wizard" model="ir.ui.view">
        <field name="name">repair.end.wizard.form</field>
        <field name="model">repair.end.wizard</field>
        <field name="arch" type="xml">
            <form string="End Repair">
                <group>
                    <field name="repair_id" readonly="1"/>
                    <field name="result" widget="radio"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
