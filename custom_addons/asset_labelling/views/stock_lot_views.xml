<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_tree_inherit_label_assets_button" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.label.assets.button</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="add_new_bulk_lots_serials.view_stock_lot_tree_inherit_add_bulk_button"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button
                    name="%(action_stock_lot_label_wizard)d"
                    string="Label Assets"
                    type="action"
                    display="always"
                    class="btn-primary"
                />
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_tree_inherit_labelled" model="ir.ui.view">
        <field name="name">stock.lot.list.inherit.labelled</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="labelled"/>
            </xpath>
        </field>
    </record>
</odoo>
