<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Template Form View to add Depreciation Information tab -->
    <record id="view_product_template_form_inherit_depreciation" model="ir.ui.view">
        <field name="name">product.template.form.inherit.depreciation</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Depreciation Information tab after Inventory tab -->
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Depreciation Information" name="depreciation_info">
                    <group>
                        <group string="Depreciation Settings">
                            <field name="depreciation_method" 
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="useful_life"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

