<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Serial Status List View -->
    <record id="view_product_serial_status_tree" model="ir.ui.view">
        <field name="name">product.serial.status.tree</field>
        <field name="model">product.serial.status</field>
        <field name="arch" type="xml">
            <list string="Serial Statuses">
                <field name="name"/>
                <field name="product_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    
    <!-- Product Serial Status Form View -->
    <record id="view_product_serial_status_form" model="ir.ui.view">
        <field name="name">product.serial.status.form</field>
        <field name="model">product.serial.status</field>
        <field name="arch" type="xml">
            <form string="Serial Status">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                    </group>
                    <group string="Products">
                        <field name="product_ids" widget="many2many_tags" 
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Product Serial Status Action -->
    <record id="action_product_serial_status" model="ir.actions.act_window">
        <field name="name">Serial Statuses</field>
        <field name="res_model">product.serial.status</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Serial Status!
            </p>
            <p>
                Define statuses that can be assigned to lots/serials. 
                Each status can be associated with specific products.
            </p>
        </field>
    </record>
    
    <!-- Menu Item -->
    <menuitem id="menu_product_serial_status"
              name="Serial Statuses"
              parent="stock.menu_stock_config_settings"
              action="action_product_serial_status"
              sequence="30"/>
</odoo>

