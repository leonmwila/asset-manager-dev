<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Stock Lot Form View to add Supplier and Serial Status to Inventory section -->
    <record id="view_stock_lot_form_inherit_inventory_fields" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.inventory.fields</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- Add Supplier and Serial Status to Inventory section -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="string">Asset</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="supplier_id"/>
                <field name="lot_acquisition_price"/>
                <!-- Temporarily commented - will uncomment after module upgrade -->
                <!-- <field name="serial_status_id" 
                       domain="[('product_ids', '=', product_id.product_tmpl_id)]"
                       options="{'no_create': True, 'no_create_edit': True}"/> -->
            </xpath>
        </field>
    </record>
    
    <!-- Inherit Stock Lot Form View to add Depreciation Information tab -->
    <record id="view_stock_lot_form_inherit_depreciation" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.depreciation</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- Create a two-tab layout inside the sheet for a cleaner form -->
            <xpath expr="//sheet/group[@name='main_group']" position="before">
                <notebook>
                    <page string="General Information" name="general_information"/>
                    <page string="Depreciation Information" name="depreciation_info">
                        <group>
                            <group string="Depreciation Details">
                                <field name="acquisition_date"/>
                                <field name="fair_value"/>
                                <field name="disposal_price"/>
                                <field name="disposal_date"/>
                                <field name="depreciation_amount" readonly="1"/>
                                <field name="nbv" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//sheet/notebook/page[@name='general_information']" position="inside">
                <xpath expr="//sheet/group[@name='main_group']" position="move"/>
                <xpath expr="//sheet/group[@name='description']" position="move"/>
            </xpath>
        </field>
    </record>
    
    <!-- Add depreciation fields to list view -->
    <record id="view_stock_lot_tree_inherit_depreciation" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.depreciation</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="supplier_id" optional="hide"/>
                <field name="lot_acquisition_price" optional="hide"/>
                <!-- <field name="serial_status_id" optional="hide"/> -->
                <field name="fair_value" optional="hide"/>
                <field name="depreciation_amount" optional="hide"/>
                <field name="nbv" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

