<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDF Barcode Label Template - Zambian GRZ Style (2 columns) -->
    <template id="report_lot_barcode_document">
            <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="2"/>
            <t t-set="data_report_header_spacing" t-value="2"/>
            
            <div class="page" style="padding: 0; margin: 0; text-align: center;">
                <style>
                    @page {
                        size: A4;
                        margin: 5mm;
                    }
                    body {
                        margin: 0;
                        padding: 0;
                    }
                    .o_label {
                        width: 98mm;
                        height: 35mm;
                        display: inline-block;
                        text-align: left;
                        padding: 2mm;
                        vertical-align: top;
                        margin: 1mm;
                        border: 1pt solid #000;
                        box-sizing: border-box;
                        overflow: hidden;
                        page-break-inside: avoid;
                        background: #fff;
                        position: relative;
                    }
                    .o_label_barcode_container {
                        display: flex;
                        flex-direction: row;
                        align-items: flex-start;
                        justify-content: space-between;
                        gap: 2mm;
                        height: 20mm;
                        width: 100%;
                    }
                    .o_label_coat_of_arms {
                        width: 18mm !important;
                        height: 18mm !important;
                        max-width: 18mm !important;
                        max-height: 18mm !important;
                        object-fit: contain;
                        flex-shrink: 0;
                        display: block;
                        position: absolute;
                        left: 6mm;
                        top: 2mm;
                    }
                    .o_label_coat_of_arms img {
                        width: 18mm !important;
                        height: 18mm !important;
                        max-width: 18mm !important;
                        max-height: 18mm !important;
                        object-fit: contain;
                        display: block;
                    }
                    .o_label_barcode_wrapper {
                        position: absolute;
                        right: 2mm;
                        top: 0mm;
                        width: 70mm;
                        height: 18mm;
                        display: flex;
                        align-items: center;
                        justify-content: flex-end;
                    }
                    .o_label_barcode_wrapper img {
                        max-height: 18mm;
                        max-width: 100%;
                        width: auto;
                        display: block;
                    }
                    .o_label_barcode_wrapper div {
                        display: flex;
                        align-items: center;
                        justify-content: flex-end;
                        height: 100%;
                        width: 100%;
                    }
                    .o_label_grz_box {
                        background-color: #000;
                        color: #fff;
                        padding: 1mm 2mm;
                        font-size: 9pt;
                        font-weight: bold;
                        font-family: Arial, sans-serif;
                        letter-spacing: 0.3px;
                        display: block;
                        position: absolute;
                        bottom: 2mm;
                        left: 2mm;
                        right: 2mm;
                        text-align: center;
                    }
                </style>
                
                <t t-foreach="docs" t-as="lot">
                    <t t-set="company" t-value="lot.company_id or (lot.product_id and lot.product_id.company_id) or lot.env.company"/>
                    <span class="o_label">
                        <!-- Barcode and Coat of Arms Container -->
                        <div class="o_label_barcode_container">
                            <!-- Company Logo with base64 encoding -->
                            <t t-if="company and company.logo">
                                <img class="o_label_coat_of_arms" t-att-src="'data:image/png;base64,%s' % company.logo.decode('utf-8')" alt="Coat of Arms"/>
                            </t>
                            <t t-else="">
                                <!-- If no logo, we'll add a placeholder or leave empty -->
                                <div class="o_label_coat_of_arms" style="background: #f0f0f0; border: 1px dashed #ccc;"></div>
                            </t>
                            <!-- Barcode using t-field with barcode widget -->
                            <div class="o_label_barcode_wrapper">
                                <t t-if="lot.grz_number">
                                    <div t-field="lot.grz_number" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 400, 'height': 100, 'img_style': 'max-height:18mm;width:auto;'}"/>
                                </t>
                                <t t-else="">
                                    <div t-field="lot.name" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 400, 'height': 100, 'img_style': 'max-height:18mm;width:auto;'}"/>
                                </t>
                            </div>
                        </div>
                        
                        <!-- GRZ Number in black box -->
                        <t t-if="lot.grz_number">
                            <div class="o_label_grz_box">
                                <t t-esc="lot.grz_number"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="o_label_grz_box">
                                <t t-esc="lot.name"/>
                            </div>
                        </t>
                    </span>
                </t>
            </div>
        </t>
    </template>

    <!-- ZPL Barcode Label Template -->
    <template id="report_lot_barcode_zpl_document">
        <t t-foreach="docs" t-as="lot">^XA
^FO50,50^BY2^BCN,100,Y,N,N^FD<t t-esc="lot.name"/>^FS
^FO50,170^A0N,25,25^FD<t t-esc="lot.name"/>^FS
^FO50,200^A0N,20,20^FD<t t-esc="lot.product_id.name[:40]"/>^FS<t t-if="lot._fields.get('grz_number') and lot.grz_number">
^FO50,230^A0N,18,18^FDGRZ: <t t-esc="lot.grz_number"/>^FS</t>
^XZ
        </t>
    </template>
</odoo>
