<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_repair_order_form_inherit_terminology" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.terminology</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="string">Asset to Repair</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Asset Quantity</attribute>
            </xpath>
        </field>
    </record>
</odoo>
