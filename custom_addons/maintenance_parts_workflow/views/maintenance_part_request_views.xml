<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_maintenance_part_request_list" model="ir.ui.view">
        <field name="name">maintenance.part.request.list</field>
        <field name="model">maintenance.part.request</field>
        <field name="arch" type="xml">
            <list string="Maintenance Part Requests">
                <field name="name"/>
                <field name="maintenance_request_id"/>
                <field name="company_id"/>
                <field name="source_company_id"/>
                <field name="source_location_id"/>
                <field name="picking_id"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <field name="approved_by"/>
                <field name="collected_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_part_request_form" model="ir.ui.view">
        <field name="name">maintenance.part.request.form</field>
        <field name="model">maintenance.part.request</field>
        <field name="arch" type="xml">
            <form string="Maintenance Part Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" groups="maintenance.group_equipment_manager" invisible="state != 'to_approve'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-secondary" groups="maintenance.group_equipment_manager" invisible="state != 'to_approve'"/>
                    <button name="action_open_for_signature" string="Add Signature" type="object" class="btn-secondary" invisible="state != 'approved'"/>
                    <button name="action_mark_collected" string="Mark Collected" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state not in ('draft', 'to_approve', 'approved', 'rejected')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,collected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="maintenance_request_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="equipment_id" readonly="1"/>
                            <field name="source_company_id" readonly="state in ('approved', 'collected', 'cancelled')"/>
                            <field name="source_location_id" readonly="state in ('approved', 'collected', 'cancelled')"/>
                            <field name="picking_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="approver_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="collected_by" readonly="1"/>
                            <field name="collected_date" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="line_ids" readonly="state not in ('draft', 'rejected')">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="qty"/>
                                <field name="product_uom_id"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </group>

                    <group string="Collection Signature" invisible="state not in ('approved', 'collected')">
                        <div class="o_form_label" invisible="state != 'approved'">Use Add Signature (or Edit) to activate the signature pad before marking collected.</div>
                        <field name="technician_signature_name" placeholder="Technician Name" readonly="state == 'collected'"/>
                        <field name="technician_signature" widget="signature" readonly="state == 'collected'"/>
                    </group>

                    <group>
                        <field name="note" placeholder="Approval or collection remarks"/>
                    </group>

                    <group>
                        <button name="action_open_picking" type="object" string="Open Stock Transfer" class="btn btn-secondary" invisible="not picking_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_maintenance_part_request" model="ir.actions.act_window">
        <field name="name">Part Requests</field>
        <field name="res_model">maintenance.part.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_maintenance_request_form_inherit_parts_workflow" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.parts.workflow</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="equipment_serial_link.view_maintenance_request_form_inherit_equipment_institution"/>
        <field name="arch" type="xml">
            <xpath expr="//page[.//field[@name='part_line_ids']]" position="inside">
                <separator string="Parts Request Workflow"/>
                <div class="d-flex gap-2 mb-2">
                    <button name="action_submit_parts_request" type="object" string="Submit Parts Request" class="btn btn-primary"/>
                    <button name="action_view_part_requests" type="object" string="View Part Requests" class="btn btn-secondary"/>
                </div>
                <field name="part_request_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="requested_by"/>
                        <field name="approver_id"/>
                        <field name="approved_by"/>
                        <field name="collected_by"/>
                        <field name="state" widget="badge"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
