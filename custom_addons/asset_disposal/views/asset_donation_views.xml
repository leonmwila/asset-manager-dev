<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_donation_tree" model="ir.ui.view">
        <field name="name">asset.donation.tree</field>
        <field name="model">asset.donation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="product_id"/>
                <field name="source_company_id"/>
                <field name="recipient_company_id"/>
                <field name="state"/>
                <field name="new_lot_id"/>
                <field name="requested_by"/>
            </list>
        </field>
    </record>

    <record id="view_asset_donation_form" model="ir.ui.view">
        <field name="name">asset.donation.form</field>
        <field name="model">asset.donation</field>
        <field name="arch" type="xml">
            <form string="Asset Donation">
                <header>
                    <button name="action_accept" type="object" string="Accept" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,accepted,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="asset_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="source_company_id" readonly="1"/>
                            <field name="recipient_company_id" readonly="1"/>
                            <field name="requested_by" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="new_lot_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_donation" model="ir.actions.act_window">
        <field name="name">Donations</field>
        <field name="res_model">asset.donation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_asset_donation" name="Donations" parent="menu_asset_disposal_root" action="action_asset_donation" sequence="20"/>
</odoo>
