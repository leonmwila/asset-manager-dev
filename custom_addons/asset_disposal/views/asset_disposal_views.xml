<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_disposal_tree" model="ir.ui.view">
        <field name="name">asset.disposal.tree</field>
        <field name="model">asset.disposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="product_id"/>
                <field name="company_id"/>
                <field name="method"/>
                <field name="state"/>
                <field name="requested_by"/>
                <field name="approved_by"/>
                <field name="approved_date"/>
            </list>
        </field>
    </record>

    <record id="view_asset_disposal_form" model="ir.ui.view">
        <field name="name">asset.disposal.form</field>
        <field name="model">asset.disposal</field>
        <field name="arch" type="xml">
            <form string="Asset Disposal">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','approved')"/>
                    <button name="action_set_to_draft" type="object" string="Set to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="asset_id" required="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="method" required="1"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="sale_price" modifiers="{'invisible': [('method', '!=', 'sold')]}"/>
                        </group>
                    </group>

                    <group string="Recipient" modifiers="{'invisible': [('method', 'in', ['discard'])]}">
                        <field name="recipient_company_id" modifiers="{'invisible': [('method', '!=', 'donate_internal')]}"/>
                        <field name="recipient_partner_id" modifiers="{'invisible': [('method', 'not in', ('donate_external','sold'))]}"/>
                        <field name="recipient_name" modifiers="{'invisible': [('method', 'not in', ('donate_external','sold'))]}"/>
                    </group>

                    <group string="Sales" modifiers="{'invisible': [('method', '!=', 'sold')]}" >
                        <field name="sale_order_id" readonly="1"/>
                        <field name="invoice_id" readonly="1"/>
                    </group>

                    <group>
                        <field name="note" placeholder="Notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_disposal" model="ir.actions.act_window">
        <field name="name">Asset Disposals</field>
        <field name="res_model">asset.disposal</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_asset_disposal_root" name="Asset Disposal" parent="stock.menu_stock_root" sequence="65"/>
    <menuitem id="menu_asset_disposal" name="Disposals" parent="menu_asset_disposal_root" action="action_asset_disposal" sequence="10"/>
</odoo>
